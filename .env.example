# Required. The Odoo base URL, no trailing slash.
# Example: https://your-odoo.example.com
VITE_ODOO_URL=https://your-odoo.example.com

# Default contract list. The app also falls back to any list containing
# "UDOWE existing contracts", so an existing UDOWE deployment still opens.
VITE_BATCH_NAME=Backfill

# Optional. Default date for a new down payment. The user can change it per
# contract. Leave it unset to use 2026-01-01.
VITE_DEPOSIT_DATE=2026-01-01
